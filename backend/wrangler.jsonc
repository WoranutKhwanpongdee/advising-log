{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advising-log-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "advising_log_db",
      "database_id": "local-advising-log-db"
    }
  ]
}